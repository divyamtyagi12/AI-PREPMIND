# PrepMind AI — Full-Stack Environment Configuration
# Copy this file to `.env` (or `server/.env`) and replace placeholders with real values.
# NEVER commit `.env` to version control.

# --- Server Runtime ---
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS + CSRF origin verification)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (MongoDB Atlas or Local Replica Set) ---
MONGODB_URI=mongodb://127.0.0.1:27017/prepmind

# --- Authentication & Security (JWT Secrets >= 32 characters each, must differ) ---
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-secure-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-at-least-32-chars

# Optional token TTL overrides
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Set to 1 when deployed behind a reverse proxy (Render, Railway, Nginx, Cloudflare)
# TRUST_PROXY=1

# --- Generative AI (Phase 2 Question Generation, Phase 6 AI Tutor, Phase 8 Mock Interviews) ---
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Sandboxed Code Execution Provider (Phase 7 Online Coding Platform) ---
# Supported values: judge0
CODE_EXECUTION_PROVIDER=judge0
CODE_EXECUTION_BASE_URL=https://judge0-ce.p.rapidapi.com
CODE_EXECUTION_API_KEY=your-judge0-or-rapidapi-key-here
CODE_EXECUTION_TIMEOUT_MS=10000
