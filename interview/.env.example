# PrepMind AI - environment variables
# Copy to `.env` in this directory and fill in real values. NEVER commit `.env`.

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (Atlas connection string, or mongodb://127.0.0.1:27017/prepmind for local) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prepmind?retryWrites=true&w=majority

# --- JWT secrets (>= 32 chars each, must differ) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-1
JWT_REFRESH_SECRET=replace-with-a-long-random-string-2

# --- Optional ---
# Set to 1 when running behind a reverse proxy (so rate limiting sees real client IPs)
# TRUST_PROXY=1

# --- Future phases (not used in Phase 1) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
