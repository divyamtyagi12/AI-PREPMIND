# PrepMind AI Backend Server — Environment Variables
# Copy to `server/.env` and fill in values.

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/prepmind

JWT_ACCESS_SECRET=replace-with-a-secure-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# TRUST_PROXY=1

# Gemini AI (Question Generation, AI Tutor, Mock Interviews)
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Sandboxed Code Execution (Judge0 CE / RapidAPI / Self-Hosted Judge0)
CODE_EXECUTION_PROVIDER=judge0
CODE_EXECUTION_BASE_URL=https://judge0-ce.p.rapidapi.com
CODE_EXECUTION_API_KEY=your-judge0-or-rapidapi-key-here
CODE_EXECUTION_TIMEOUT_MS=10000

