# ─────────────────────────────────────────────
# Interview Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Google Gemini API Key (supports AIza... and AQ... key formats)
GEMINI_API_KEY=REPLACE_ME

# LLM model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Data paths (relative to project root)
CURRICULUM_PATH=./data/curriculum.json
CANDIDATES_PATH=./data/candidates.json

# Optional: logging level (debug | info | warn | error)
LOG_LEVEL=info
